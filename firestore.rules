rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Enquiries Collection:
    // Anyone can create (submit enquiry form), ONLY authenticated users can read, update, or delete
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Auditions Collection:
    // Anyone can create (submit casting audition), ONLY authenticated users can read, update, or delete
    match /auditions/{auditionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Website Content Collection:
    // Anyone can read site content, ONLY authenticated users can write/update
    match /content/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
